	UV.update_spectate = function(dt)
		local enabled = UV.spec_enabled
		if not enabled then if Spectate.active then spectate_stop() end return end
		local name = UV.spec_target
		if not name or name == "no players" then if Spectate.active then spectate_stop() end return end
		local plr = Plrs:FindFirstChild(name)
		if not plr or not plr.Character then if Spectate.active then spectate_stop() end return end
		local tc = plr.Character
		local th = tc:FindFirstChildOfClass("Humanoid")
		local tr = tc:FindFirstChild("HumanoidRootPart")
		if not th or not tr then if Spectate.active then spectate_stop() end return end
		if th.Health <= 0 and UV.spec_dead_action == "Stop" then if Spectate.active then spectate_stop() end return end
		local cam = WS.CurrentCamera
		if not cam then return end
		if not Spectate.active then Spectate.active = true; Spectate.saved_type = cam.CameraType end
