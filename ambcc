local function ensureTracers()
	if tracerGui and tracerGui.Parent then return tracerGui end
	tracerGui = Instance.new("ScreenGui")
	tracerGui.Name = "AmbientTracers"
	tracerGui.ResetOnSpawn = false
	tracerGui.IgnoreGuiInset = true
	tracerGui.DisplayOrder = 9
	tracerGui.Enabled = tracersOn
	tracerGui.Parent = lp:WaitForChild("PlayerGui")
	RunService.RenderStepped:Connect(function()
		if not tracersOn then return end
		local cam = workspace.CurrentCamera
		if not cam then return end
		local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
		local i = 0
		for _, plr in ipairs(PlayersSvc:GetPlayers()) do
			if plr == lp then continue end
			local char = plr.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hrp and hum and hum.Health > 0 then
				if teamCheck and plr.Team == lp.Team and plr.Team ~= nil then continue end
				local pos, onScreen = cam:WorldToViewportPoint(hrp.Position)
				if onScreen then
					i += 1
					local line = tracerPool[i]
					if not line or not line.Parent then
						line = Instance.new("Frame")
						line.AnchorPoint = Vector2.new(0.5, 0.5)
						line.BackgroundColor3 = Color3.fromRGB(34, 211, 238)
						line.BackgroundTransparency = 0.25
						line.BorderSizePixel = 0
						line.Parent = tracerGui
						tracerPool[i] = line
					end
					line.Visible = true
					local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
					line.Position = UDim2.new(0, (center.X + pos.X) / 2, 0, (center.Y + pos.Y) / 2)
					line.Size = UDim2.new(0, 1.5, 0, dist)
					line.Rotation = math.deg(math.atan2(pos.Y - center.Y, pos.X - center.X)) + 90
				end
			end
		end
		for j = i + 1, #tracerPool do
			if tracerPool[j] then tracerPool[j].Visible = false end
		end
	end)
	return tracerGui
end

