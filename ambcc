		if not Spectate.active then return end
		Spectate.active = false
		local cam = WS.CurrentCamera
		pcall(function() cam.CameraType = Spectate.saved_type or Enum.CameraType.Custom end)
		local c, r, h = my_char()
		if h and cam then pcall(function() cam.CameraSubject = h end) end
		Spectate.last_name = nil
	end
	UV.spectate_stop = spectate_stop
