		end)
		return roots
	end
	local function ncApply(label, text, map)
		local key = string.lower(text)
		local rep = map[key] or (NC.defaultName ~= "" and NC.defaultName or nil)
		if not rep then
			-- partial: replace any known name hiding inside longer text
			for name, _ in pairs(ncTargets()) do
				if #name > 2 and string.find(key, name, 1, true) then
					rep = map[name] or NC.defaultName
					if rep and rep ~= "" then
						text = string.gsub(text, name, string.lower(rep) == rep and rep or rep)
					end
				end
			end
			if not rep or rep == "" then return end
		end
		if NC.orig[label] == nil then
			NC.orig[label] = { text = label.Text, color = label.TextColor3 }
		end
		label.Text = rep
		label.TextColor3 = NC.color
		if NC.gradient then
			local g = label:FindFirstChild("AmbientNCGrad")
			if not g then
				g = Instance.new("UIGradient")
				g.Name = "AmbientNCGrad"
				g.Rotation = 0
				g.Parent = label
			end
			g.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, NC.color),
				ColorSequenceKeypoint.new(1, NC.color2),
			})
		else
			local g = label:FindFirstChild("AmbientNCGrad")
			if g then g:Destroy() end
		end
	end
	local function ncRestore()
		for label, o in pairs(NC.orig) do
			pcall(function()
				label.Text = o.text
				label.TextColor3 = o.color
				local g = label:FindFirstChild("AmbientNCGrad")
				if g then g:Destroy() end
			end)
		end
		table.clear(NC.orig)
		for hum, name in pairs(NC.origHum) do
			pcall(function() hum.DisplayName = name end)
		end
		table.clear(NC.origHum)
	end
