		elseif mode == "Free Look" then
			pcall(function()
				cam.CameraType = Enum.CameraType.Scriptable
				cam.CFrame = CFrame.lookAt(tr.Position + v3(UV.spec_offset_x, UV.spec_offset_y, UV.spec_offset_z), tr.Position)
			end)
		elseif mode == "First Person" then
			local head = tc:FindFirstChild("Head")
			if head then
				pcall(function()
					cam.CameraType = Enum.CameraType.Custom
					cam.CameraSubject = th
					cam.CFrame = CFrame.lookAt(head.Position, head.Position + tr.CFrame.LookVector)
				end)
			end
		end
	end
end

