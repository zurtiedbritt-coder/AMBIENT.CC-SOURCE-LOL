		if not g then if not Gun.active and UV.gun_notify then notify("no gun found", "warning") end return end
		if not Gun.active then Gun.active = true if UV.gun_notify then notify("gun method: " .. g.Name, "success") end end
		if UV.gun_auto_equip then
			if g.Parent ~= c then
				local ct = c:FindFirstChildOfClass("Tool")
				if ct and ct ~= g then Gun.last_tool = ct end
				pcall(function() h:EquipTool(g) end)
			end
		end
		local target = UV.Sa and UV.Sa.lockedTarget
		if not target or not target.Character then return end
		if is_fully_dead_UV(target) then return end
		local now = os.clock()
		if (now - Gun.last) >= (UV.gun_fire_delay / 1000) then
			Gun.last = now
			if UV.gun_auto_shoot and g then gun_shoot() end
		end
		if (now - Gun.last_reload) >= (UV.gun_reload_interval / 1000) then
			Gun.last_reload = now
			if UV.gun_auto_reload then send_reload_key() end
		end
	end
	UV.update_gun_method = update_gun_method

	-- AUTO STOMP
	UV.stomp_enabled, UV.stomp_rb2_only = false, true
	UV.stomp_search_range, UV.stomp_offset, UV.stomp_interval, UV.stomp_fire_count = 1000, 3.5, 50, 10
	UV.stomp_notify, UV.stomp_link, UV.stomp_key = true, false, Enum.KeyCode.J
	UV.stomp_link_color = Color3.fromHex("#FF2E2E")
	local sf = hcTab:AddSubTab("Stomp")
	sf:AddSection("Auto Stomp")
	sf:AddToggle({ Flag = "uv_p36",  Name = "Enabled", Default = false, Callback = function(v) UV.stomp_enabled = v end })
	sf:AddKeybind({ Flag = "uv_p37",  Name = "Stomp Key", Default = Enum.KeyCode.J, Callback = function(k) if k then UV.stomp_key = k end end })
	sf:AddToggle({ Flag = "uv_p38",  Name = "Only Stomp RB2 Target", Default = true, Callback = function(v) UV.stomp_rb2_only = v end })
	sf:AddSlider({ Flag = "uv_p39",  Name = "Search Range", Min = 5, Max = 5000, Default = 1000, Suffix = "st", Callback = function(v) UV.stomp_search_range = v end })
	sf:AddSlider({ Flag = "uv_p40",  Name = "Stand Offset", Min = 0, Max = 100, Default = 35, Callback = function(v) UV.stomp_offset = v / 10 end })
	sf:AddSlider({ Flag = "uv_p41",  Name = "Stomp Interval", Min = 5, Max = 500, Default = 50, Suffix = "ms", Callback = function(v) UV.stomp_interval = v end })
	sf:AddSlider({ Flag = "uv_p42",  Name = "Fire Count", Min = 1, Max = 30, Default = 10, Callback = function(v) UV.stomp_fire_count = v end })
	sf:AddToggle({ Flag = "uv_p43",  Name = "Notify", Default = true, Callback = function(v) UV.stomp_notify = v end })
	sf:AddToggle({ Flag = "uv_p44",  Name = "Target Link", Default = false, Callback = function(v) UV.stomp_link = v end })
	sf:AddColorPicker({ Flag = "uv_p45",  Name = "Link Color", Default = Color3.fromHex("#FF2E2E"), Callback = function(v) UV.stomp_link_color = v end })
	local Stomp = { active = false, return_pos = nil, target = nil, target_name = nil, last = 0, stomps = 0, stuck_timer = 0, state = "idle" }
	UV.Stomp = Stomp
	local function stop_stomp()
		local c, r, h = my_char()
		if Stomp.return_pos and r then
			r.CFrame = Stomp.return_pos
			r.AssemblyLinearVelocity = v3()
			r.AssemblyAngularVelocity = v3()
		end
		if h then h.Sit = false; h.PlatformStand = false; pcall(function() h:ChangeState(Enum.HumanoidStateType.GettingUp) end) end
		Stomp.active = false Stomp.return_pos = nil Stomp.target = nil Stomp.target_name = nil
		Stomp.stomps = 0 Stomp.stuck_timer = 0 Stomp.state = "idle"
		if UV.StompLink then UV.StompLink.Visible = false end
	end
	UV.stop_stomp = stop_stomp
	local function update_auto_stomp(dt)
		local hold = false
		pcall(function() hold = UIS:IsKeyDown(UV.stomp_key) end)
		local enabled = UV.stomp_enabled or hold
		local c, r, h = my_char()
		if not enabled or not c or not r or not h then
			if Stomp.active then stop_stomp() if UV.stomp_notify then notify("auto stomp stopped", "info") end end
			return
		end
		if h.Health <= 0 then if Stomp.active then stop_stomp() end return end
		if not Stomp.active then Stomp.active = true; Stomp.return_pos = r.CFrame; Stomp.state = "seeking"; if UV.stomp_notify then notify("auto stomp active", "success") end end
		if Stomp.state == "seeking" and not Stomp.target then Stomp.return_pos = r.CFrame end
		if UV.stomp_rb2_only then
			local rb2name = UV.rb2_target
			local rb2 = rb2name and Plrs:FindFirstChild(rb2name) or nil
			if not rb2 or not rb2.Character then
				if Stomp.target then Stomp.target = nil; Stomp.target_name = nil; Stomp.state = "seeking" end
				return
			end
			if UV.is_ko(rb2) then
				if Stomp.target ~= rb2 then Stomp.target = rb2; Stomp.target_name = rb2.Name; Stomp.return_pos = r.CFrame; Stomp.state = "stomping"; Stomp.stuck_timer = 0; if UV.stomp_notify then notify("stomping rb2 target: " .. rb2.Name, "success") end end
			elseif UV.is_fully_dead(rb2) then
				if Stomp.return_pos and r then r.CFrame = Stomp.return_pos; r.AssemblyLinearVelocity = v3() end
				Stomp.target = nil Stomp.target_name = nil Stomp.state = "seeking"
				return
			else
				if Stomp.target then Stomp.target = nil; Stomp.target_name = nil; Stomp.state = "seeking" end
				return
			end
		else
			if Stomp.target then
				if UV.is_fully_dead(Stomp.target) then
					if Stomp.return_pos and r then r.CFrame = Stomp.return_pos; r.AssemblyLinearVelocity = v3() end
					Stomp.target = nil Stomp.target_name = nil Stomp.state = "seeking"
				elseif not UV.is_ko(Stomp.target) then
					Stomp.target = nil Stomp.target_name = nil Stomp.state = "seeking"
				end
			end
			if not Stomp.target then
				local best, bd = nil, math.huge
				for _, p in ipairs(Plrs:GetPlayers()) do
					if p ~= LP and p.Character and UV.is_ko(p) then
						local rr = p.Character:FindFirstChild("HumanoidRootPart")
						if rr then local d = (r.Position - rr.Position).Magnitude; if d <= UV.stomp_search_range and d < bd then bd = d; best = p end end
					end
				end
				if best then Stomp.target = best; Stomp.target_name = best.Name; Stomp.return_pos = r.CFrame; Stomp.state = "stomping"; Stomp.stuck_timer = 0; if UV.stomp_notify then notify("stomping " .. best.Name, "success") end else return end
			end
		end
		local target = Stomp.target
		if not target or not target.Character then Stomp.target = nil; Stomp.target_name = nil; Stomp.state = "seeking"; return end
		local tc = target.Character
		local ut = tc:FindFirstChild("UpperTorso") or tc:FindFirstChild("Torso") or tc:FindFirstChild("HumanoidRootPart")
		if not ut then Stomp.stuck_timer += dt; if Stomp.stuck_timer > 2 then Stomp.target = nil; Stomp.target_name = nil; Stomp.state = "seeking"; Stomp.stuck_timer = 0 end; return end
		if UV.is_fully_dead(target) then
			if Stomp.return_pos and r then r.CFrame = Stomp.return_pos; r.AssemblyLinearVelocity = v3() end
			Stomp.target = nil; Stomp.target_name = nil; Stomp.state = "seeking"; return
		end
		local goal = ut.Position + v3(0, UV.stomp_offset, 0)
		h.Sit = false h.PlatformStand = false
		pcall(function() h:ChangeState(Enum.HumanoidStateType.GettingUp) end)
		r.AssemblyLinearVelocity = v3() r.AssemblyAngularVelocity = v3()
		r.CFrame = CFrame.new(goal)
		local now = os.clock()
		if (now - Stomp.last) >= (UV.stomp_interval / 1000) then
			Stomp.last = now Stomp.stomps += 1
			for _ = 1, UV.stomp_fire_count do pcall(function() if MainEvent then MainEvent:FireServer("Stomp") end end) end
		end
		r.AssemblyLinearVelocity = v3(); r.AssemblyAngularVelocity = v3()
		Stomp.stuck_timer += dt
		if Stomp.stuck_timer > 15 then
			if Stomp.return_pos and r then r.CFrame = Stomp.return_pos; r.AssemblyLinearVelocity = v3() end
			Stomp.target = nil; Stomp.target_name = nil; Stomp.state = "seeking"; Stomp.stuck_timer = 0; return
		end
		if UV.StompLink then
			if UV.stomp_link then
				local cam = WS.CurrentCamera
				local sp, on = cam:WorldToViewportPoint(ut.Position)
				local mp, mon = cam:WorldToViewportPoint(r.Position)
				if on and mon then UV.StompLink.Visible = true; UV.StompLink.Color = UV.stomp_link_color; UV.StompLink.From = Vector2.new(mp.X, mp.Y); UV.StompLink.To = Vector2.new(sp.X, sp.Y) else UV.StompLink.Visible = false end
			else UV.StompLink.Visible = false end
		end
	end
	UV.update_auto_stomp = update_auto_stomp
	print("[ambient] stage 2 knife/gun/stomp OK")
end

-- helper used by gun stage (defined here so stage order never matters)
function is_fully_dead_UV(plr)
	local UV = getgenv().AmbientUV
	if UV and UV.is_fully_dead then return UV.is_fully_dead(plr) end
	return false
end

