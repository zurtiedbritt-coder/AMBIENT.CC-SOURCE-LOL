	-- RB2 engine
	local Rb2 = { angle = 0, flip = 1, flip_time = 0, last = 0, origin = nil, on = false, saved = {}, last_name = nil, mode_swap = 0, last_mode = nil, vel_lerp = v3() }
	UV.Rb2 = Rb2
	local function rb2_collide(char, restore)
		if not char then return end
		for _, p in char:GetDescendants() do
			if p:IsA("BasePart") then
				if restore then
					if Rb2.saved[p] ~= nil then p.CanCollide = Rb2.saved[p] Rb2.saved[p] = nil end
				else
					if Rb2.saved[p] == nil then Rb2.saved[p] = p.CanCollide end
					p.CanCollide = false
				end
			end
		end
	end
	local function rb2_stop(char, root)
		if Rb2.on and Rb2.origin and root then root.CFrame = Rb2.origin end
		rb2_collide(char, true)
		if char then local h = char:FindFirstChildOfClass("Humanoid") if h then h.PlatformStand = false end end
		Rb2.on = false Rb2.origin = nil Rb2.vel_lerp = v3()
		table.clear(UV.TrailPoints)
	end
	UV.rb2_stop = rb2_stop
	local function rb2_entry()
		local name = UV.rb2_target
		if not name or name == "no players" then return nil end
		local plr = Plrs:FindFirstChild(name)
		if not plr then return nil end
		local ch = plr.Character
		if not ch then return nil end
		local hum = ch:FindFirstChildOfClass("Humanoid")
		local root = ch:FindFirstChild("HumanoidRootPart")
		if not hum or not root then return nil end
		return { char = ch, hum = hum, root = root, plr = plr }
	end
	local function get_current_mode(now)
		if UV.rb2_auto_mode then
			if (now - Rb2.mode_swap) >= UV.rb2_auto_mode_interval then
				Rb2.mode_swap = now
				Rb2.last_mode = ALL_MODES[random(1, #ALL_MODES)]
				if UV.rb2_notify then notify("orbit mode: " .. Rb2.last_mode, "info") end
			end
			return Rb2.last_mode or "Orbit"
		else
			return UV.rb2_mode
		end
	end
	local function rb2_position(entry, dt, now)
		local tp = entry.root.Position
		if UV.rb2_predict then
			local vel = entry.root.AssemblyLinearVelocity
			Rb2.vel_lerp = Rb2.vel_lerp:Lerp(v3(vel.X, 0, vel.Z), clamp(dt * 10, 0, 1))
			tp += Rb2.vel_lerp * UV.rb2_predict_amount
		end
		local mode = get_current_mode(now)
		local radius, speed = UV.rb2_radius, UV.rb2_speed
		if UV.rb2_dist_speed then
			local _, mr = my_char()
			if mr then speed = speed * clamp((mr.Position - entry.root.Position).Magnitude / 500, 0.3, 3) end
		end
		if UV.rb2_dir == "Counter-Clockwise" then Rb2.flip = -1
		elseif UV.rb2_dir == "Alternate" then
			if now - Rb2.flip_time >= UV.rb2_flip_time then Rb2.flip = -Rb2.flip; Rb2.flip_time = now end
		else Rb2.flip = 1 end
		Rb2.angle += dt * speed * Rb2.flip
		if Rb2.angle > pi * 4 then Rb2.angle = Rb2.angle % (pi * 2) end
		local a = Rb2.angle
		if UV.rb2_pulse > 0 then radius += sin(now * UV.rb2_pulse_speed) * UV.rb2_pulse end
		if UV.rb2_radius_var > 0 then radius += sin(a * 3) * UV.rb2_radius_var end
		local height = UV.rb2_height
		if UV.rb2_bob > 0 then height += sin(now * UV.rb2_bob_speed) * UV.rb2_bob end
		local offset
		if mode == "Behind" then
			local look = entry.root.CFrame.LookVector
			local flat = v3(look.X, 0, look.Z)
			flat = flat.Magnitude > 0 and flat.Unit or v3(0, 0, -1)
			offset = -flat * UV.rb2_behind_dist
		elseif mode == "Above" then
			offset = v3(cos(a) * radius, abs(height) + UV.rb2_behind_dist, sin(a) * radius) height = 0
		elseif mode == "Below" then
			offset = v3(cos(a) * radius, -(abs(height) + UV.rb2_behind_dist), sin(a) * radius) height = 0
		elseif mode == "Strafe" then
			local look = entry.root.CFrame.LookVector
			local right = v3(-look.Z, 0, look.X)
			right = right.Magnitude > 0 and right.Unit or v3(1, 0, 0)
			offset = right * sin(a) * radius
		elseif mode == "Figure 8" then
			offset = v3(sin(a) * radius, 0, sin(a * 2) * radius * 0.5)
		elseif mode == "Spiral" then
			local r = radius * (0.35 + 0.65 * abs(sin(now * 0.5)))
			offset = v3(cos(a) * r, sin(a * 0.5) * radius * 0.5, sin(a) * r)
		elseif mode == "Triangle" then
			local n, sa = 3, pi * 2 / 3
			local idx = math.floor(a / sa) % n
			local frac = (a % sa) / sa
			local pts = {}
			for i = 0, n - 1 do local aa = i * sa pts[i + 1] = v3(cos(aa) * radius, 0, sin(aa) * radius) end
			offset = pts[idx + 1]:Lerp(pts[(idx % n) + 1], frac)
		elseif mode == "Zigzag" then
			offset = v3(sin(a) * radius, sin(a * 4) * UV.rb2_bob, cos(a * 2) * radius * 0.5)
		elseif mode == "Random" then
			offset = v3(cos(a * 1.3) * radius, sin(a * 0.7) * radius * 0.3, sin(a * 1.7) * radius)
		elseif mode == "DNA" then
			offset = v3(cos(a) * radius, sin(a * 2) * radius * 0.4, sin(a) * radius)
		elseif mode == "Helix" then
			offset = v3(cos(a) * radius, sin(a) * radius * 0.6, sin(a) * radius)
		elseif mode == "Vortex" then
			local r = radius * (0.2 + 0.8 * abs(sin(a * 0.5)))
			offset = v3(cos(a * 3) * r, sin(a) * radius * 0.3, sin(a * 3) * r)
		elseif mode == "Square" then
			local n, sa = 4, pi * 2 / 4
			local idx = math.floor(a / sa) % n
			local frac = (a % sa) / sa
			local pts = {}
			for i = 0, n - 1 do local aa = i * sa pts[i + 1] = v3(cos(aa) * radius, 0, sin(aa) * radius) end
			offset = pts[idx + 1]:Lerp(pts[(idx % n) + 1], frac)
		elseif mode == "Star" then
			local n = 10
			local sa = pi * 2 / n
			local idx = math.floor(a / sa) % n
			local frac = (a % sa) / sa
			local pts = {}
			for i = 0, n - 1 do local aa = i * sa local r = (i % 2 == 0) and radius or radius * 0.4 pts[i + 1] = v3(cos(aa) * r, 0, sin(aa) * r) end
			offset = pts[idx + 1]:Lerp(pts[(idx % n) + 1], frac)
		elseif mode == "Clover" then
			offset = v3(cos(a) * radius + cos(a * 2) * radius * 0.3, 0, sin(a) * radius + sin(a * 2) * radius * 0.3)
		elseif mode == "Pulse Wave" then
			local r = radius * (0.5 + 0.5 * sin(a * 2))
			offset = v3(cos(a) * r, sin(a * 3) * radius * 0.2, sin(a) * r)
		elseif mode == "Tornado" then
			local r = radius * (0.3 + 0.7 * (a % (pi * 2)) / (pi * 2))
			offset = v3(cos(a * 2) * r, sin(a * 3) * radius * 0.4, sin(a * 2) * r)
		elseif mode == "Sway" then
			offset = v3(sin(a) * radius, sin(a * 0.5) * radius * 0.2, cos(a * 0.5) * radius * 0.3)
		elseif mode == "Bounce" then
			offset = v3(cos(a) * radius * 0.3, abs(sin(a * 2)) * radius, sin(a) * radius * 0.3)
		else
			offset = v3(cos(a) * radius, 0, sin(a) * radius)
		end
		local look = entry.root.CFrame.LookVector
		local flat = v3(look.X, 0, look.Z)
		flat = flat.Magnitude > 0 and flat.Unit or v3(0, 0, -1)
		local side = v3(-flat.Z, 0, flat.X)
		offset += flat * UV.rb2_forward
		offset += side * UV.rb2_side
		offset += v3(0, height, 0)
		if UV.rb2_jitter > 0 then
			offset += v3((random() - 0.5) * UV.rb2_jitter, (random() - 0.5) * UV.rb2_jitter, (random() - 0.5) * UV.rb2_jitter)
		end
		return tp + offset
	end
	local function draw_rb2_path(entry)
		if not UV.rb2_path or not entry then UV.hide_pool(1) return end
		local cam = WS.CurrentCamera
		if not cam then return end
		local segs = math.floor(UV.rb2_path_segs)
		local center = entry.root.Position + v3(0, UV.rb2_height, 0)
		local pts, count = {}, 0
		for i = 0, segs do
			local a = (i / segs) * pi * 2
			local sp, on = cam:WorldToViewportPoint(center + v3(cos(a) * UV.rb2_radius, 0, sin(a) * UV.rb2_radius))
			pts[i + 1] = on and v2(sp.X, sp.Y) or nil
		end
		for i = 1, segs do
			local p1, p2 = pts[i], pts[i + 1]
			if p1 and p2 then
				count += 1
				local l = UV.pool_line(count)
				if l then l.Visible, l.Color, l.From, l.To = true, UV.rb2_path_color, p1, p2 end
			end
		end
		UV.hide_pool(count + 1)
	end
	local function update_trail(pos)
		local cam = WS.CurrentCamera
		if not cam then return end
		if not UV.rb2_trail then
			for _, l in ipairs(UV.TrailLines) do if l then pcall(function() l.Visible = false end) end end
			table.clear(UV.TrailPoints)
			return
		end
		table.insert(UV.TrailPoints, 1, pos)
		while #UV.TrailPoints > UV.rb2_trail_length do table.remove(UV.TrailPoints) end
		for i = 1, UV.rb2_trail_length do
			if not UV.TrailLines[i] then
				if typeof(Drawing) == "table" then
					local ok, l = pcall(Drawing.new, "Line")
					if ok and l then l.Thickness = 1 UV.TrailLines[i] = l end
				end
			end
			local l = UV.TrailLines[i]
			if l and UV.TrailPoints[i] and UV.TrailPoints[i + 1] then
				local sp1, on1 = cam:WorldToViewportPoint(UV.TrailPoints[i])
				local sp2, on2 = cam:WorldToViewportPoint(UV.TrailPoints[i + 1])
				if on1 and on2 then
					l.Visible = true l.Color = UV.rb2_trail_color
					l.From = v2(sp1.X, sp1.Y) l.To = v2(sp2.X, sp2.Y)
					l.Transparency = 1 - (i / UV.rb2_trail_length)
				else l.Visible = false end
			elseif l then l.Visible = false end
		end
	end
	UV.update_ragebot_v2 = function(dt)
		local c, r, h = my_char()
		local Stomp = UV.Stomp
		if Stomp and Stomp.active and Stomp.target then
			if Rb2.on then rb2_stop(c, r) end
			UV.hide_pool(1)
			if UV.Rb2Link then UV.Rb2Link.Visible = false end
			return
		end
		if not UV.rb2_enabled or not c or not r or not h then
			if Rb2.on then rb2_stop(c, r) end
			UV.hide_pool(1)
			if UV.Rb2Link then UV.Rb2Link.Visible = false end
			return
		end
		if UV.rb2_autodie and h.Health <= 0 then
			rb2_stop(c, r)
			return
		end
		local entry = rb2_entry()
		if not entry then
			if Rb2.on then rb2_stop(c, r) end
			UV.hide_pool(1)
			if UV.Rb2Link then UV.Rb2Link.Visible = false end
			return
		end
		local _, mr = my_char()
		if mr and (mr.Position - entry.root.Position).Magnitude > UV.rb2_range then
			if Rb2.on then rb2_stop(c, r) end
			UV.hide_pool(1)
			if UV.Rb2Link then UV.Rb2Link.Visible = false end
			return
		end
		if not Rb2.on then Rb2.on = true; Rb2.origin = r.CFrame end
		if UV.rb2_noclip then rb2_collide(c, false) end
		local now = os.clock()
		if UV.rb2_rate > 0 and (now - Rb2.last) < (UV.rb2_rate / 1000) then draw_rb2_path(entry) return end
		Rb2.last = now
		local goal = rb2_position(entry, dt, now)
		if UV.rb2_face then
			r.CFrame = CFrame.lookAt(goal, entry.root.Position)
		else
			r.CFrame = CFrame.new(goal) * (r.CFrame - r.CFrame.Position)
		end
		r.AssemblyLinearVelocity = v3()
		h.PlatformStand = false
		r.AssemblyLinearVelocity = v3()
		update_trail(r.Position)
		draw_rb2_path(entry)
		if UV.Rb2Link then
			if UV.rb2_link then
				local cam = WS.CurrentCamera
				local sp, on = cam:WorldToViewportPoint(entry.root.Position)
				local mp, mon = cam:WorldToViewportPoint(r.Position)
				if on and mon then
					UV.Rb2Link.Visible = true UV.Rb2Link.Color = UV.rb2_link_color
					UV.Rb2Link.From = v2(mp.X, mp.Y) UV.Rb2Link.To = v2(sp.X, sp.Y)
				else UV.Rb2Link.Visible = false end
			else UV.Rb2Link.Visible = false end
		end
		local name = entry.plr and entry.plr.Name or nil
		if name ~= Rb2.last_name then
			Rb2.last_name = name
			if name and UV.rb2_notify then notify("ragebot v2 locked: " .. name, "success") end
		end
	end

	-- PANIC (inside Hood Customs tab)
	local panicMain = getgenv().AmbientHCTab:AddSubTab("Panic")
	panicMain:AddSection("Panic")
	panicMain:AddButton({ Name = "Disable Everything", Callback = function()
		UV.sa_enabled, UV.hc_knife_enabled, UV.rb2_enabled = false, false, false
		UV.stomp_enabled, UV.vel_enabled, UV.spec_enabled, UV.gun_enabled = false, false, false, false
		getgenv().Silent.Enabled = false
		if UV.Sa then UV.Sa.lockedTarget = nil end
		if UV.SaFovCircle then UV.SaFovCircle.Visible = false end
		if UV.SaFovFill then UV.SaFovFill.Visible = false end
		if UV.SaTracer then UV.SaTracer.Visible = false end
		local c, r = my_char()
		if UV.rb2_stop then UV.rb2_stop(c, r) end
		if UV.stop_stomp then UV.stop_stomp() end
		if UV.vel_spoof_stop then UV.vel_spoof_stop() end
		if UV.spectate_stop then UV.spectate_stop() end
		if UV.Gun then UV.Gun.active = false end
		if UV.Knife and UV.Knife.active then UV.Knife.active = false if UV.unequip_to_last then UV.unequip_to_last() end end
		notify("everything disabled", "warning")
	end })

	-- MAIN LOOP + RESET
	game:GetService("RunService").Heartbeat:Connect(function(dt)
		pcall(function() if UV.update_silent_aim then UV.update_silent_aim() end end)
		pcall(function() if UV.update_auto_knife then UV.update_auto_knife() end end)
		pcall(function() if UV.update_auto_stomp then UV.update_auto_stomp(dt) end end)
		pcall(function() if UV.update_ragebot_v2 then UV.update_ragebot_v2(dt) end end)
		pcall(function() if UV.update_velocity_spoofer then UV.update_velocity_spoofer() end end)
		pcall(function() if UV.update_spectate then UV.update_spectate(dt) end end)
		pcall(function() if UV.update_gun_method then UV.update_gun_method() end end)
	end)
	LP.CharacterAdded:Connect(function()
		pcall(function()
			if UV.Knife then UV.Knife.active = false; UV.Knife.last_tool = nil end
			if UV.Rb2 then Rb2.saved = {}; Rb2.on = false; Rb2.origin = nil; Rb2.last_name = nil; Rb2.vel_lerp = v3() end
			-- RB2 auto-resume: fresh body, fresh origin, keep hunting if it was on
			if UV.rb2_enabled then
				task.delay(1, function()
					pcall(function()
						Rb2.origin = nil; Rb2.on = false; Rb2.angle = 0
						notify("ragebot resumed after respawn", "success")
					end)
				end)
			end
			if UV.Stomp then UV.Stomp.active = false; UV.Stomp.target = nil; UV.Stomp.return_pos = nil; UV.Stomp.state = "idle" end
			if UV.VelSpoof then UV.VelSpoof.active = false end
			if UV.Spectate then UV.Spectate.active = false; UV.Spectate.last_name = nil end
			if UV.Gun then UV.Gun.active = false; UV.Gun.last_name = nil end
			if UV.Sa then UV.Sa.lockedTarget = nil; UV.Sa.last_name = nil end
			getgenv().Silent.Enabled = false
			if UV.SaFovCircle then UV.SaFovCircle.Visible = false end
			if UV.SaFovFill then UV.SaFovFill.Visible = false end
			if UV.SaTracer then UV.SaTracer.Visible = false end
			table.clear(UV.TrailPoints)
			UV.hide_pool(1)
			if UV.Rb2Link then UV.Rb2Link.Visible = false end
			if UV.StompLink then UV.StompLink.Visible = false end
		end)
	end)
	notify("uv.win port loaded — all features live", "success")
	-- music panel shows with the UI (no K needed); default key M, rebindable in Settings
	getgenv().AmbientMusicKey = getgenv().AmbientMusicKey or Enum.KeyCode.M
	task.delay(1.5, function()
		pcall(function() if getgenv().AmbientToggleMusic then getgenv().AmbientToggleMusic() end end)
	end)
end

