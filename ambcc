							if rep and rep ~= "" then
								if NC.origHum[hum] == nil then NC.origHum[hum] = hum.DisplayName end
								if hum.DisplayName ~= rep then hum.DisplayName = rep end
							end
						end
					end
				end
			end)
			if not ok then task.wait(1) end
		end
	end)
	-- instant swap the moment game UI adds text (no waiting for next sweep)
	for _, root in ipairs(ncRoots()) do
		pcall(function()
