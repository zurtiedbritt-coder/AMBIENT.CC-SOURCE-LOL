		if not VelSpoof.active then VelSpoof.active = true if UV.vel_notify then notify("velocity spoofer active", "success") end end
		local mode = UV.vel_mode
		if mode == "Static" then
			r.AssemblyLinearVelocity = v3(UV.vel_x, UV.vel_y, UV.vel_z)
		elseif mode == "Random" then
