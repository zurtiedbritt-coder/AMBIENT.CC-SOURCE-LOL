							local targets = ncTargets()
							if targets[string.lower(d.Text)] then
								ncApply(d, d.Text, ncMappings())
							end
						end
					end)
				end)
			end)
		end)
	end
	setMain:AddToggle({ Name = "Name Changer", Default = NC.enabled, Callback = function(v)
		NC.enabled = v
		if not v then ncRestore() end
		notify(v and "name changer ON" or "names restored", v and "success" or "info")
	end })
	setMain:AddInput({ Name = "Mappings (old=new;...)", Default = NC.mapText, Placeholder = "yuke=ambient;max=ambient", Callback = function(v) NC.mapText = v or "" end })
	setMain:AddInput({ Name = "Default Name", Default = NC.defaultName, Placeholder = "empty = only mapped", Callback = function(v) NC.defaultName = v or "" end })
	setMain:AddColorPicker({ Name = "Name Color", Default = NC.color, Callback = function(c) if typeof(c) == "Color3" then NC.color = c end end })
